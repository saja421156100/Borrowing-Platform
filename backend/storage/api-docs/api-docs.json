            },
            "put": {
                "tags": [
                    "Borrowings - Admin"
                ],
                "summary": "Update borrowing status",
                "description": "Admin only. Update the status of a borrowing request.",
                "operationId": "964e5799dbf2294f669f8521c86f3556",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Borrowing ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 4
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "status"
                                ],
                                "properties": {
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "pending",
                                            "approved",
                                            "borrowed",
                                            "returned",
                                            "rejected"
                                        ],
                                        "example": "approved"
                                    },
                                    "returned_at": {
                                        "type": "string",
                                        "format": "date",
                                        "example": null,
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Borrowing updated successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Admin access required"
                    },
                    "404": {
                        "description": "Borrowing not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
