        "/api/borrowings": {
            "get": {
                "tags": [
                    "Borrowings - Admin"
                ],
                "summary": "Get all borrowing requests",
                "description": "Admin only. Return all borrowing requests with item and user information.",
                "operationId": "c3a233a596178776aee29e62407e35f5",
                "responses": {
                    "200": {
                        "description": "Borrowing requests retrieved successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Admin access required"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Borrowings"
                ],
                "summary": "Create a borrowing request",
                "description": "Create a new borrowing request for an item.",
                "operationId": "71dbdaf2e2dac0ffd35a68d80f3331bd",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "item_id",
                                    "user_id",
                                    "borrowed_at",
                                    "due_date"
                                ],
                                "properties": {
                                    "item_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "user_id": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "borrowed_at": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-08-28"
                                    },
                                    "due_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-08-30"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Borrowing request created successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
