                                    "description": {
                                        "type": "string",
                                        "example": "Dell laptop available for borrowing"
                                    },
                                    "image": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
