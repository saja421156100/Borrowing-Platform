        "/api/items": {
            "get": {
                "tags": [
                    "Items"
                ],
                "summary": "Get all items",
                "description": "Get items with search, filtering, sorting and pagination.",
                "operationId": "2cbf07eb95d033f8775c36424ac8fa06",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search by item name or description",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "Laptop"
                    },
                    {
                        "name": "category_id",
                        "in": "query",
                        "description": "Filter items by category",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Filter items by status",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "available",
                                "borrowed"
                            ]
                        },
                        "example": "available"
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort items",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "name",
                                "newest",
                                "oldest"
                            ]
                        },
                        "example": "name"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Number of items per page",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 50,
                            "minimum": 1
                        },
                        "example": 10
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Items retrieved successfully"
                    }
                }
            },
